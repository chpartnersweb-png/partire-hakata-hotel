---
const slides = [{src:'/images/hero/exterior.webp',alt:'実際の外観写真をもとに生成したパルティーレ博多の全景イメージ',label:'外観全景'},{src:'/images/hero/balconies.webp',alt:'実際の外観写真をもとに生成したタイルの外壁とバルコニーのイメージ',label:'外壁とバルコニー'},{src:'/images/hero/entrance.webp',alt:'実際の外観写真をもとに生成したエントランスのイメージ',label:'エントランス'}];
---
<section class="hero" id="top" aria-label="パルティーレ博多ホテル メインビジュアル" aria-roledescription="カルーセル"><div class="hero-slides">{slides.map((slide,i)=><div class:list={['hero-slide',{'is-active':i===0}]} data-hero-slide aria-hidden={i!==0}><img src={i===0?slide.src:undefined} data-src={slide.src} alt={slide.alt} width="1672" height="941" fetchpriority={i===0?'high':'auto'} decoding="async" /></div>)}</div><div class="hero-shade"></div><div class="hero-copy"><p class="hero-eyebrow">PARTIRE HAKATA HOTEL</p><h1><span>春吉から、</span><span>福岡を歩く。</span></h1></div><a href="#intro" class="hero-scroll" aria-label="ホテルのご案内へスクロール"><span>SCROLL</span><i></i></a><div class="hero-controls" aria-label="メイン画像の切り替え">{slides.map((slide,i)=><button class:list={['hero-dot',{'is-active':i===0}]} data-slide-to={i} aria-label={`${i+1}枚目 ${slide.label}を表示`} aria-pressed={i===0}><span></span></button>)}<button id="hero-pause" class="hero-pause" aria-label="スライドショーを一時停止" aria-pressed="false"><span></span><span></span></button></div><p class="hero-note">外観写真をもとにした生成イメージ</p></section>
