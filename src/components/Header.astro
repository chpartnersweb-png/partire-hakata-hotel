---
import { hotel } from '../data/hotel';
import Icon from './Icon.astro';
const links = [['rooms','客室','Rooms'],['price','宿泊料金','Price'],['services','ご滞在について','Your stay'],['access','アクセス','Access'],['contact','お問い合わせ','Contact']];
---
<a class="skip-link" href="#main">本文へ移動</a>
<header class="site-header" id="site-header"><a class="brand" href="#top" aria-label={`${hotel.name} トップへ`}><span class="brand__main">Partire</span><span class="brand__sub">HAKATA HOTEL</span><span class="brand__jp">パルティーレ博多ホテル</span></a><div class="header-actions"><a class="header-contact" href="#contact">ご宿泊のお問い合わせ <Icon name="arrow" /></a><button class="menu-toggle" id="menu-open" aria-label="メニューを開く" aria-haspopup="dialog" aria-controls="site-menu"><span></span><span></span><small>MENU</small></button></div></header>
<dialog id="site-menu" class="site-menu" aria-label="サイトメニュー"><div class="menu-top"><a class="brand" href="#top"><span class="brand__main">Partire</span><span class="brand__sub">HAKATA HOTEL</span></a><button class="menu-close" id="menu-close" aria-label="メニューを閉じる"><span></span><span></span><small>CLOSE</small></button></div><div class="menu-body"><p class="menu-intro">春吉から、<br />福岡を歩く。</p><nav aria-label="メインナビゲーション">{links.map(([id,jp,en],index)=><a href={`#${id}`}><small>0{index+1}</small><span>{en}<em>{jp}</em></span><Icon name="arrow" /></a>)}</nav></div><a class="menu-phone" href={hotel.tel}>TEL <span>{hotel.phone}</span></a></dialog>
