---
import images from '../data/room-images.json';
import {roomNumbers,roomPrice,hotel,yen} from '../data/hotel';
import Icon from './Icon.astro';
const firstRoom='101'; const gallery=images[firstRoom]; const price=roomPrice(firstRoom);
---
<section id="rooms" class="rooms section-pad"><div class="section-heading wrap" data-reveal><div><p class="eyebrow"><span>01</span> OUR ROOMS</p><h2>それぞれの部屋で、<br />思い思いのひととき。</h2></div><p class="section-aside">お部屋の写真を見ながら、<br />旅の時間を思い描く。</p></div><div class="room-tabs wrap" role="tablist" aria-label="客室を選択">{roomNumbers.map(number=><button id={`tab-${number}`} class:list={['room-tab',{'is-active':number===firstRoom}]} role="tab" aria-selected={number===firstRoom} aria-controls="room-panel" tabindex={number===firstRoom?0:-1} data-room={number}><small>ROOM</small><span>{number}</span></button>)}</div><div id="room-panel" role="tabpanel" aria-labelledby="tab-101" class="room-layout" tabindex="0"><div class="gallery"><div class="gallery-stage" id="gallery-stage"><button class="gallery-expand" id="gallery-expand" aria-label="101号室の写真を拡大"><img id="room-photo" src={gallery[0]?.src} alt="101号室の客室写真 1" width="1600" height="1200" loading="lazy" decoding="async" /><span class="expand-mark"><Icon name="expand" /> <span>写真を拡大</span></span></button><div class="gallery-navigation"><span class="photo-count"><b id="photo-current">01</b><i></i><span id="photo-total">{String(gallery.length).padStart(2,'0')}</span></span><div><button class="photo-arrow prev" id="photo-prev" aria-label="前の客室写真"><Icon name="arrow" /></button><button class="photo-arrow" id="photo-next" aria-label="次の客室写真"><Icon name="arrow" /></button></div></div></div><div class="gallery-thumbs" id="gallery-thumbs" aria-label="客室写真の選択">{gallery.map((img,i)=><button data-photo={i} aria-label={`101号室の写真 ${i+1}を表示`} aria-pressed={i===0}><img src={img.thumb} alt="" width="240" height="160" loading="lazy" /></button>)}</div></div><div class="room-detail"><p class="eyebrow">PARTIRE HAKATA</p><h3><small>ROOM</small> <span id="room-number">101</span></h3><p class="room-capacity">最大{hotel.capacity}名様まで</p><dl class="room-prices"><div><dt>平日料金</dt><dd><span id="room-weekday">{yen(price.weekday)}</span><small>円</small></dd></div><div><dt>週末料金</dt><dd><span id="room-weekend">{yen(price.weekend)}</span><small>円</small></dd></div></dl><p class="fine-print">2名様までのご宿泊料金を含みます。<br />追加人数料金・清掃費は別途かかります。</p><a href="#price" class="text-link">料金・ご利用条件を見る <Icon name="arrow" /></a><a href={hotel.tel} class="outline-button">このお部屋について問い合わせる <Icon name="arrow" /></a><p class="sr-only" id="room-announcement" aria-live="polite"></p></div></div><script id="room-data" type="application/json" set:html={JSON.stringify({images,prices:Object.fromEntries(roomNumbers.map(n=>[n,roomPrice(n)]))}).replaceAll('<','\\u003c')} /></section>
<dialog class="lightbox" id="lightbox" aria-label="客室写真の拡大表示"><div class="lightbox-head"><p id="lightbox-label">ROOM 101</p><button id="lightbox-close" aria-label="拡大写真を閉じる">閉じる <span>×</span></button></div><div class="lightbox-image"><img id="lightbox-photo" alt="" /><button id="lightbox-prev" class="lightbox-arrow prev" aria-label="前の写真"><Icon name="arrow" /></button><button id="lightbox-next" class="lightbox-arrow" aria-label="次の写真"><Icon name="arrow" /></button></div><p id="lightbox-count"></p></dialog>
